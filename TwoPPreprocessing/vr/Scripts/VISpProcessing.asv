pairs.M25126 = ['20260311', '20260312', '20260313']; % unique fovs 
 

VISpSessions = filterMasterTable_usingNameSessionPairs('MousePairs', pairs, 'Exclude', 0);

% edit this function to include SNTmatrix 
VISpData = getTuningDataByCondition(VISpSessions); 

%% Heatmaps for individual mice; only include rois that are stable across; Self normalised 
% first/second halves of laps 
% Corrected call:
plotEvenTuningHeatmaps(VISpData, ...
    'DaysToPlot', 200, ...
    'UseStabilityFilter', true, ...
    'SavePath', 'Z:\ibn-vision\USERS\Sonali\Figures\NewVISpMice\EvenLaps_SortedByOdd.png')
%% Population pooled across days 
plotPooledPopulation(VISpData, 'V1',...
    'SavePath', 'Z:\ibn-vision\USERS\Sonali\Figures\NewVISpMice\VISp_PooledNewCorridor2026_withoutRangeNorm.png', ...
    'DaysToPlot', 200, ...
    'TypeToPlot', 'Boutons');
%%
VISpData = getTuningDataByCondition(VISpSessions,'signalToUse', 'spks');
plotConditionTuning(VISpData, 'V1', 200, '\\rdp.arc.ucl.ac.uk\ritd-ag-project-rd01ie-asale69\ibn-vision\USERS\Sonali\Figures\NewVISpMice\VISpAcrossCondition.png')
