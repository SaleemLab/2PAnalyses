function plotSingleROI_ConditionStack(sessionFileInfo, response, neuronIdx, signalToUse)
% plotSingleROI_ConditionStack: Generates a multi-row summary for a single ROI
% showing Rasters and Tuning Curves for every condition.

if nargin < 4, signalToUse = 'dFFNeuropilCorrected'; end

% 1. Setup Data
data = response.lapPositionActivity.(signalToUse);
roiActivity = squeeze(data(neuronIdx, :, :));
conds = fieldnames(response.trialIndicesByCondition);
nBins = size(roiActivity, 2);
xPos = 1:nBins;

% Define a high-contrast color palette
% [Baseline: Black, Swap: Blue, Omit/Skip: Magenta, Zero Contrast: Cyan]
colors = {[0 0 0], [0 0.45 0.74], [0.85 0.33 0.1], [0.93 0.69 0.13], [0.49 0.18 0.56], [0.3 0.75 0.93]};

% 2. Create Figure
fig = figure('Color', 'w', 'Position', [100 100 1200 900]);
nConds = length(conds);
t = tiledlayout(nConds, 2, 'TileSpacing', 'compact', 'Padding', 'normal');
title(t, sprintf('%s | ROI %d | %s', sessionFileInfo.session_name, neuronIdx, signalToUse), ...
    'FontSize', 14, 'FontWeight', 'bold');

% Get Baseline for reference (assuming 'baseline' is in the name)
baseIdx = find(contains(lower(conds), 'baseline'), 1);
if isempty(baseIdx), baseIdx = 1; end
baseLaps = response.trialIndicesByCondition.(conds{baseIdx});
baseMu = mean(roiActivity(baseLaps, :), 1, 'omitnan');

% 3. Loop through conditions and stack vertically
for iC = 1:nConds
    currCond = conds{iC};
    trialIDs = response.trialIndicesByCondition.(currCond);
    if isempty(trialIDs), continue; end
    
    currColor = colors{mod(iC-1, length(colors))+1};
    
    %% Left Tile: Raster
    nexttile; hold on;
    % Plot activity as a "heatmap-style" raster or dot raster
    imagesc(xPos, 1:length(trialIDs), roiActivity(trialIDs, :));
    colormap(gca, flipud(gray));
    title(strrep(currCond, '_', ' '));
    ylabel('Laps');
    if iC < nConds, set(gca, 'XTickLabel', []); end
    
    %% Right Tile: Tuning Curve (Mean + SEM)
    nexttile; hold on;
    % Plot Baseline as a gray reference in the background
    plot(xPos, baseMu, 'Color', [0.7 0.7 0.7], 'LineWidth', 1.5, 'LineStyle', '--');
    
    % Plot Current Condition
    mu = mean(roiActivity(trialIDs, :), 1, 'omitnan');
    sem = std(roiActivity(trialIDs, :), 0, 1, 'omitnan') ./ sqrt(length(trialIDs));
    
    fill([xPos, fliplr(xPos)], [mu+sem, fliplr(mu-sem)], currColor, ...
        'FaceAlpha', 0.2, 'EdgeColor', 'none');
    plot(xPos, mu, 'Color', currColor, 'LineWidth', 2);
    
    % Formatting
    ylim([0 max(roiActivity(:)) * 0.8]); % Consistent Y-axis
    if iC < nConds, set(gca, 'XTickLabel', []); end
    if iC == 1, title('Mean Activity (\pm SEM)'); end
    
    % Vertical lines for landmarks (e.g., 40, 80, 120, 160 cm)
    for p = [40 80 120 160], xline(p, 'k:', 'Alpha', 0.3); end
end

xlabel(t, 'Position (cm)');

% 4. Save
saveDir = fullfile(sessionFileInfo.Directories.save_folder, 'ROI_Examples');
if ~exist(saveDir, 'dir'), mkdir(saveDir); end
saveas(fig, fullfile(saveDir, sprintf('ROI_%d_Summary.png', neuronIdx)));

end