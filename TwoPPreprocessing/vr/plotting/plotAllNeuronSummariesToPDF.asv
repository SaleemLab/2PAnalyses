function plotAllNeuronSummariesToPDF(sessionFileInfo, response, selectedROIs, applySmoothing)
%   Plots summary for SPECIFIC ROIs in a tiled format with threshold metrics.
%   Saves as a high-resolution PNG.

if nargin < 4, applySmoothing = true; end

%% 1. Load Threshold Metrics
outputFilePath = sessionFileInfo.otherSessFilePaths.sessionROIData;
if exist(outputFilePath, 'file') == 2
    loadedMetrics = load(outputFilePath); 
    signalToUse = 'dFFNeuropilCorrected'; % Standardizing to your requested signal
    
    % Extract arrays for the requested metrics
    peakSig  = loadedMetrics.nullDist_PeakTuningMetric.isSignificantByPeakShuffling.(signalToUse);
    rangeSig = loadedMetrics.nullDist_RangeTuningMetric.isSignificantByRange.(signalToUse);
    varToVar = loadedMetrics.tuningCurveVariance.ratioVarToTuningVar;
    varToRange = loadedMetrics.tuningCurveVariance.ratioVarToTuningRange;
    halvesRho = loadedMetrics.lapCorr_Halves.rho;
    oeRho = loadedMetrics.lapCorr_OddEven.rho;
    
    % Mapping roisToKeep to a logical mask
    roisToKeepMask = false(size(varToVar));
    if isfield(loadedMetrics.highlyCorrBoutons, 'roisToKeep')
        roisToKeepMask(loadedMetrics.highlyCorrBoutons.roisToKeep) = true;
    end
    metricsLoaded = true;
else
    warning('sessionROIData not found. Metrics will be skipped.');
    metricsLoaded = false;
end

%% 2. Setup Figure and Output
figSaveDir = fullfile(sessionFileInfo.Directories.save_folder, 'Figures');
if ~exist(figSaveDir, 'dir'), mkdir(figSaveDir); end
savePath = fullfile(figSaveDir, sprintf('%s_%s_Selected_ROI_Gallery.png', ...
    sessionFileInfo.animal_name, sessionFileInfo.session_name));

lapActivityFull = response.lapPositionActivity.dFFNeuropilCorrected;
numROIs = length(selectedROIs);

% Create figure with TiledLayout
fig = figure('Color', 'w', 'Units', 'normalized', 'Position', [0.1 0.1 0.8 0.9]);
t = tiledlayout(numROIs, 2, 'TileSpacing', 'compact', 'Padding', 'loose');
sgtitle(t, sprintf('Selected ROI Analysis: %s | %s', ...
    sessionFileInfo.animal_name, sessionFileInfo.session_name), 'FontSize', 14);

%% 3. Loop through Selected ROIs
for i = 1:numROIs
    neuronIdx = selectedROIs(i);
    roiActivity = squeeze(lapActivityFull(neuronIdx, :, :));
    
    % Optional Smoothing
    if applySmoothing
        w = gausswin(5); w = w / sum(w);
        for iLap = 1:size(roiActivity, 1)
            trace = roiActivity(iLap, :);
            if all(isnan(trace)), continue; end
            nanMask = isnan(trace); trace(nanMask) = 0;
            smoothed = filtfilt(w, 1, trace);
            smoothed(nanMask) = NaN;
            roiActivity(iLap, :) = smoothed;
        end
    end

    % --- Subplot A: Mean Activity + Criteria Text ---
    nexttile; hold on;
    meanAct = mean(roiActivity, 1, 'omitnan');
    semAct = std(roiActivity, 0, 1, 'omitnan') ./ sqrt(sum(~isnan(roiActivity), 1));
    x = 1:size(meanAct, 2);
    
    fill([x fliplr(x)], [meanAct+semAct, fliplr(meanAct-semAct)], [0.8 0.8 0.8], 'EdgeColor', 'none', 'FaceAlpha', 0.4);
    plot(x, meanAct, 'k', 'LineWidth', 1.5);
    
    % Formatting
    xticks([0 50 70 90 110 140]); grid on;
    ylabel('dFF'); title(sprintf('ROI %d', neuronIdx));
    
    if metricsLoaded
        % Display criteria similar to the summary function
        critStr = {sprintf('Sig P|R: %d|%d  Halves: %.2f', peakSig(neuronIdx), rangeSig(neuronIdx), halvesRho(neuronIdx)), ...
                   sprintf('V/V: %.1f  V/R: %.1f  OE: %.2f  Keep: %d', varToVar(neuronIdx), varToRange(neuronIdx), oeRho(neuronIdx), roisToKeepMask(neuronIdx))};
        
        text(0.5, 0.98, critStr, 'Units', 'normalized', 'HorizontalAlignment', 'center', ...
            'VerticalAlignment', 'top', 'FontSize', 8, 'BackgroundColor', [1 1 1 0.6], 'EdgeColor', [0.7 0.7 0.7]);
    end

    % --- Subplot B: Interleaved Heatmap (Odd/Even) ---
    nexttile;
    % Extracting Odd and Even rows
    nLaps = floor(size(roiActivity, 1) / 2);
    interleaved = zeros(nLaps*2, size(roiActivity, 2));
    interleaved(1:2:end, :) = roiActivity(1:2:(2*nLaps-1), :); % Odd
    interleaved(2:2:end, :) = roiActivity(2:2:(2*nLaps), :);   % Even
    
    imagesc(normalize(interleaved, 2, 'range'));
    colormap(flipud(gray)); caxis([0 1]);
    ylabel('Laps (O-E-O-E)'); title('Interleaved Heatmap');
    xticks([0 50 70 90 110 140]);
end

%% 4. Save High-Res Output
exportgraphics(fig, savePath, 'Resolution', 300);
fprintf('ROI Gallery saved to: %s\n', savePath);
end