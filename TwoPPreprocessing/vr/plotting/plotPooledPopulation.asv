% function figHandle = plotPooledPopulation(allData, targetArea, varargin)
% % plotPooledPopulation Plots activity pooled across ALL mice for a specific area.
% %
% % Usage: 
% %   plotPooledPopulation(allData, 'RSP', 'DaysToPlot', [1 3 5])
% %   plotPooledPopulation(allData, 'RSP', 'TypeToPlot', 'Somas')
% 
%     p = inputParser;
%     addRequired(p, 'allData', @isstruct);
%     addRequired(p, 'targetArea', @ischar);
%     addParameter(p, 'DaysToPlot', [1, 2, 3, 4, 5], @isnumeric);
%     addParameter(p, 'TypeToPlot', 'Boutons', @ischar);
%     addParameter(p, 'SavePath', '', @ischar);
%     parse(p, allData, targetArea, varargin{:});
% 
%     daysToPlot = p.Results.DaysToPlot;
%     typeRequested = p.Results.TypeToPlot;
%     nDays = length(daysToPlot);
% 
%     figHandle = figure('Position', [100 100 300*nDays 400]);
%     t = tiledlayout(figHandle, 1, nDays, 'TileSpacing', 'compact', 'Padding', 'compact');
% 
%     for d = 1:nDays
%         day = daysToPlot(d);
%         ax = nexttile;
% 
%         % FIND ALL sessions that match: Day AND Area AND Type
%         % Note: Changed 'TargetArea' to 'Area' to match getTuningData.m
%         daySessions = allData([allData.Day] == day & ...
%                               strcmpi({allData.TargetArea}, targetArea) & ...
%                               strcmpi({allData.Type}, typeRequested));
% 
%         if isempty(daySessions)
%             title(ax, ['Day ' num2str(day) ' - No Data']); 
%             axis(ax, 'off'); 
%             continue;
%         end
% 
%         % POOL THEM: Concatenate every mouse's data for this day
%         pooledOdd = vertcat(daySessions.OddMean);
%         pooledEven = vertcat(daySessions.EvenMean);
% 
%         plotTuningInAxes(ax, pooledOdd, pooledEven);
% 
%         % Labels
%         title(ax, ['Day ' num2str(day)]);
%         if d==1
%              ylabel(ax, {['Pooled ' targetArea]; ['(' typeRequested ')']}, ...
%                  'Interpreter', 'none', 'FontSize', 12, 'FontWeight', 'bold');
%         end
%         if d==nDays
%             colorbar; 
%         end
%     end
% 
%     % Global title for context
%     title(t, sprintf('Pooled Population: %s (%s)', targetArea, typeRequested), ...
%         'Interpreter', 'none', 'FontSize', 14);
% 
%     if ~isempty(p.Results.SavePath)
%         saveas(figHandle, p.Results.SavePath);
%     end
% end
function figHandle = plotPooledPopulation(allData, targetArea, varargin)
% plotPooledPopulation: High-quality pooled activity with adjusted scale bar.

    p = inputParser;
    addRequired(p, 'allData', @isstruct);
    addRequired(p, 'targetArea', @(x) ischar(x) || isstring(x));
    
    addParameter(p, 'DaysToPlot', [1, 2, 3, 4, 5], @isnumeric);
    addParameter(p, 'TypeToPlot', 'Boutons', @(x) ischar(x) || isstring(x));
    addParameter(p, 'SavePath', '', @(x) ischar(x) || isstring(x));
    addParameter(p, 'UseStabilityFilter', true, @islogical);
    addParameter(p, 'StableThresh', 0.5, @isnumeric); 
    
    parse(p, allData, targetArea, varargin{:});
    
    % --- DATA RECOVERY ---
    if all(cellfun(@isempty, {allData.TargetArea})), [allData.TargetArea] = deal(char(targetArea)); end
    if all(cellfun(@isempty, {allData.Type})), [allData.Type] = deal(char(p.Results.TypeToPlot)); end

    daysToPlot = p.Results.DaysToPlot;
    nDays = length(daysToPlot);

    figHandle = figure('Position', [100 100 300*nDays 300], 'Color', 'w');
    t = tiledlayout(figHandle, 1, nDays, 'TileSpacing', 'compact', 'Padding', 'loose');
    
    for d = 1:nDays
        day = daysToPlot(d);
        ax = nexttile;
        
        daySessions = allData([allData.Day] == day & ...
                              strcmpi(string({allData.TargetArea}), string(targetArea)) & ...
                              strcmpi(string({allData.Type}), string(p.Results.TypeToPlot)));
        
        if isempty(daySessions), axis(ax, 'off'); continue; end
        
        allOdd = []; allEven = [];
        for s = 1:length(daySessions)
            thisSess = daySessions(s);
            if isempty(thisSess.OddMean), continue; end
            idx = 1:size(thisSess.OddMean, 1);
            if p.Results.UseStabilityFilter && isfield(thisSess, 'lapCorr_HalvesRho')
                idx = intersect(idx, find(thisSess.lapCorr_HalvesRho >= p.Results.StableThresh));
            end
            if ~isempty(idx)
                allOdd  = vertcat(allOdd, thisSess.OddMean(idx, :));
                allEven = vertcat(allEven, thisSess.EvenMean(idx, :));
            end
        end
        
        if ~isempty(allEven)
            normOdd = normalize(allOdd, 2, 'range');
            [~, peaks] = max(normOdd, [], 2);
            [~, sIdx] = sort(peaks); 
            normEvenSorted = normalize(allEven(sIdx, :), 2, 'range');
            normEvenSorted(isnan(normEvenSorted)) = 0;
            
            imagesc(ax, normEvenSorted);
            colormap(ax, flipud(gray)); 
            
            set(ax, 'CLim', [0.25 0.75], 'YDir', 'normal', 'Box', 'off', 'TickDir', 'out');
            set(ax, 'YTick', [], 'FontSize', 10);
            set(ax, 'YColor', 'none');
            xlabel(ax, 'Position (cm)', 'FontSize', 11);
            xticks([40 80 120 160]);
           
    
            % --- RELATIVE SCALE BAR (Middle-aligned Text) ---
            numN = size(normEvenSorted, 1);
            if numN >= 100
                hold(ax, 'on');
                
                % Anchor the bottom of the bar to 20% of the plot height
                % This ensures a consistent visual "starting height" across panels
                y_start = numN * 0.2; 
                y_end   = y_start + 100; % Absolute 100 units long
                y_mid   = y_start + 50;  % The exact center of the bar
                
                % Horizontal spacing (snug to the plot)
                x_line = -6; 
                x_text = -14; 
                
                % 1. Draw the Line
                line(ax, [x_line x_line], [y_start y_end], ...
                    'Color', 'k', 'LineWidth', 2, 'Clipping', 'off');
                
                % 2. Draw the Text (Centered on the line)
                text(ax, x_text, y_mid, '100 boutons', ...
                    'Rotation', 90, ...
                    'HorizontalAlignment', 'center', ... % Centers the text vertically
                    'VerticalAlignment', 'middle', ...   % Centers the text horizontally relative to x_text
                    'FontSize', 11, ...
                    'FontWeight', 'normal', ...
                    'Clipping', 'off');
            end
            % --- SLIM COLORBAR (Ticks Right, Label Inside/Left) ---
            if d == nDays
                cb = colorbar(ax);
                
            
                pos = get(ax, 'Position');
                cb.Position = [pos(1)+pos(3)+0.02, pos(2)+pos(4)*0.3, 0.012, pos(4)*0.4];
                
                % 2. Force Ticks to the Right
                cb.AxisLocation = 'out'; 
                cb.Ticks = [0.25 0.75];
                cb.TickLabels = {'0.25', '0.75'};
                cb.TickDir = 'right';
                cb.Box = 'off';
                
                % 3. Force Label to the Left (Inside)
                cb.Label.String = 'Activity (norm.)';
                cb.Label.FontSize = 10;
                
                % 'bottom' alignment pushes the text to the left of the bar axis
                cb.Label.VerticalAlignment = 'bottom'; 
                cb.Label.Rotation = 90;
                
                % 4. Fine-tuning the gap
                % If the label is too close to the bar, you can slightly 
                % adjust its horizontal position manually:
                % cb.Label.Position(1) = -1.5; 
            end
            
            % --- TITLE ---
            titleColors = {'r', [0.4 0.7 0.2], 'b', 'm', 'k'};
            thisCol = titleColors{mod(d-1,5)+1};
            title(ax, sprintf('Day %d (n=%d)', day, numN), ...
                'Color', thisCol, 'FontSize', 12, 'FontWeight', 'normal');
        else
            axis(ax, 'off');
        end
    end
    
    if ~isempty(p.Results.SavePath)
        exportgraphics(figHandle, p.Results.SavePath, 'Resolution', 600);
    end
end