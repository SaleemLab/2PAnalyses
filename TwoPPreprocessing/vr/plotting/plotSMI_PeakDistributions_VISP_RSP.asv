function plotSMI_PeakDistributions_VISP_RSP(RSPData, VISpData)
   
    partnerLandmarkPosition = 80;   
    excludeStart = 30; 
    excludeEnd = 30;
    fprintf('Processing RSP Peak Positions...\n');
    
    rspPeaks_LowSMI  = [];
    rspPeaks_HighSMI = [];
    allRSP_SMI = [];
    
    for s = 1:length(RSPData)
        sess = RSPData(s);
        if isfield(sess, 'SMI') && isfield(sess, 'FilteredROIs') && ~isempty(sess.FilteredROIs)
            vals = sess.SMI.SMI(sess.FilteredROIs);
            allRSP_SMI = [allRSP_SMI; vals(~isnan(vals))];
        end
    end
    medianRSP_SMI = median(allRSP_SMI);
    for s = 1:length(RSPData)
        sess = RSPData(s);
        if ~isfield(sess, 'ConditionData') || ~isfield(sess.ConditionData, 'Baseline') || ...
           ~isfield(sess, 'FilteredROIs') || isempty(sess.FilteredROIs)
            continue;
        end
        
        lapActivity = sess.ConditionData.Baseline.LapActivity;
        [~, ~, nBins] = size(lapActivity);
        validLapRange = (excludeStart + 1) : (nBins - excludeEnd);
        
        meanOdd = squeeze(mean(lapActivity(:, 1:2:end, :), 2, 'omitnan'));
        smiValues = sess.SMI.SMI;
        
        for i = 1:length(sess.FilteredROIs)
            roiIdx = sess.FilteredROIs(i);
            smiVal = smiValues(roiIdx);
            if isnan(smiVal); continue; end
            
            roiTrace = meanOdd(roiIdx, :);
            [pks, locs] = findpeaks(roiTrace);
            validMask = ismember(locs, validLapRange);
            validPks = pks(validMask); validLocs = locs(validMask);
            
            if ~isempty(validLocs)
                [~, maxPeakIdx] = max(validPks);
                prefBin = validLocs(maxPeakIdx);
            else
                [~, maxRelIdx] = max(roiTrace(validLapRange));
                prefBin = validLapRange(maxRelIdx);
            end
            
            if smiVal < 0
                rspPeaks_LowSMI = [rspPeaks_LowSMI; prefBin];
            elseif smiVal > medianRSP_SMI
                rspPeaks_HighSMI = [rspPeaks_HighSMI; prefBin];
            end
        end
    end
    fprintf('Processing VISp Peak Positions...\n');
    
    vispPeaks_LowSMI  = [];
    vispPeaks_HighSMI = [];
    allVISp_SMI = [];
    
    for s = 1:length(VISpData)
        sess = VISpData(s);
        if isfield(sess, 'SMI') && isfield(sess, 'FilteredROIs') && ~isempty(sess.FilteredROIs)
            vals = sess.SMI.SMI(sess.FilteredROIs);
            allVISp_SMI = [allVISp_SMI; vals(~isnan(vals))];
        end
    end
    medianVISp_SMI = median(allVISp_SMI);
    for s = 1:length(VISpData)
        sess = VISpData(s);
        if ~isfield(sess, 'ConditionData') || ~isfield(sess.ConditionData, 'Baseline') || ...
           ~isfield(sess, 'FilteredROIs') || isempty(sess.FilteredROIs)
            continue;
        end
        
        lapActivity = sess.ConditionData.Baseline.LapActivity;
        [~, ~, nBins] = size(lapActivity);
        validLapRange = (excludeStart + 1) : (nBins - excludeEnd);
        
        meanOdd = squeeze(mean(lapActivity(:, 1:2:end, :), 2, 'omitnan'));
        smiValues = sess.SMI.SMI;
        
        for i = 1:length(sess.FilteredROIs)
            roiIdx = sess.FilteredROIs(i);
            smiVal = smiValues(roiIdx);
            if isnan(smiVal); continue; end
            
            roiTrace = meanOdd(roiIdx, :);
            [pks, locs] = findpeaks(roiTrace);
            validMask = ismember(locs, validLapRange);
            validPks = pks(validMask); validLocs = locs(validMask);
            
            if ~isempty(validLocs)
                [~, maxPeakIdx] = max(validPks);
                prefBin = validLocs(maxPeakIdx);
            else
                [~, maxRelIdx] = max(roiTrace(validLapRange));
                prefBin = validLapRange(maxRelIdx);
            end
            
            if smiVal < 0
                vispPeaks_LowSMI = [vispPeaks_LowSMI; prefBin];
            elseif smiVal > medianVISp_SMI
                vispPeaks_HighSMI = [vispPeaks_HighSMI; prefBin];
            end
        end
    end
    
    figHandle = figure('Name', 'Peak Position Density Distribution', ...
                       'Color', [1 1 1], 'Position', [150, 150, 1000, 900]);
                   
    binEdges = 1:1:200; 
    landmarkCentres = [40, 80, 120, 160];
    
    % --- SUBPLOT 1: RSP LOW SMI ---
    subplot(2, 2, 1); hold on;
    for l = 1:length(landmarkCentres)
        xline(landmarkCentres(l), ':', 'Color', [0.6 0.6 0.6], 'LineWidth', 1.5, 'HandleVisibility', 'off');
    end
    histogram(rspPeaks_LowSMI, 'BinEdges', binEdges, 'Normalization', 'pdf', ...
              'FaceColor', [0 0 0], 'EdgeColor', 'none', 'FaceAlpha', 0.7);
    xlabel('Position (cm)');
    ylabel('Probability');
    title(sprintf('RSP boutons: SMI < 0\n(n = %d)', length(rspPeaks_LowSMI)));
    xlim([0 200]);
    xticks(landmarkCentres);
    box off; axis square;
    defaultAxesProperties(gca)
    offsetAxes()
    
    %
    subplot(2, 2, 2); hold on;
    for l = 1:length(landmarkCentres)
        xline(landmarkCentres(l), ':', 'Color', [0.6 0.6 0.6], 'LineWidth', 1.5, 'HandleVisibility', 'off');
    end
    histogram(rspPeaks_HighSMI, 'BinEdges', binEdges, 'Normalization', 'pdf', ...
              'FaceColor', [0 0 0], 'EdgeColor', 'none', 'FaceAlpha', 0.8);
    xlabel('Position (cm)');
    ylabel('Probability');
    title(sprintf('RSP boutons: SMI > median\n(n = %d)', length(rspPeaks_HighSMI)));
    xlim([0 200]);
    xticks(landmarkCentres);
    box off; axis square;
    defaultAxesProperties(gca)
    offsetAxes()
    
    % --- SUBPLOT 3: VISp LOW SMI ---
    subplot(2, 2, 3); hold on;
    for l = 1:length(landmarkCentres)
        xline(landmarkCentres(l), ':', 'Color', [0.6 0.6 0.6], 'LineWidth', 1.5, 'HandleVisibility', 'off');
    end
    histogram(vispPeaks_LowSMI, 'BinEdges', binEdges, 'Normalization', 'pdf', ...
              'FaceColor', [0 0 0], 'EdgeColor', 'none', 'FaceAlpha', 0.7);
    xlabel('Position (cm)');
    ylabel('Probability');
    title(sprintf('VISp somas: SMI < 0\n(n = %d)', length(vispPeaks_LowSMI)));
    xlim([0 200]);
    xticks(landmarkCentres);
    box off; axis square;
    defaultAxesProperties(gca)
    offsetAxes()
    
    % 
    subplot(2, 2, 4); hold on;
    for l = 1:length(landmarkCentres)
        xline(landmarkCentres(l), ':', 'Color', [0.6 0.6 0.6], 'LineWidth', 1.5, 'HandleVisibility', 'off');
    end
    histogram(vispPeaks_HighSMI, 'BinEdges', binEdges, 'Normalization', 'pdf', ...
              'FaceColor', [0 0 0], 'EdgeColor', 'none', 'FaceAlpha', 0.8);
    xlabel('Position (cm)');
    ylabel('Probability');
    title(sprintf('VISp somas: SMI > median\n(n = %d)', length(vispPeaks_HighSMI)));
    xlim([0 200]);
    xticks(landmarkCentres);
    box off; axis square;
    defaultAxesProperties(gca)
    offsetAxes()
    
    outputDir = 'Z:\ibn-vision\USERS\Sonali\Figures\ThesisFigs\ResultsChapter1';
    if ~exist(outputDir, 'dir')
        mkdir(outputDir);
    end
    
    baseFileName = 'smi_peak_position_distributions';
    fullSavePath = fullfile(outputDir, baseFileName);
    
    saveFigureFormats(figHandle, fullSavePath);
    fprintf('Peak spatial distribution plots generated and saved cleanly to thesis target directory.\n');
end