function plotAllNeuronSummariesToPDF_withThresholds(sessionFileInfo, response, applySmoothing, signalToUse)
%   Plots summary for all ROIs (cells and non-cells) and exports all
%   plots into one multipage PDF. 
%
%   Updated Metrics: 
%   - Significant by Peak Shuffle (1/0)
%   - Significant by Range Shuffle (1/0)
%   - Var/TuningVar 
%   - Var/TuningRange
%   - Correlation Kept (from roisToKeep)
%   - Halves correlation 
%   - OddEven correlation (added ..) 

if nargin < 3
    applySmoothing = false;
end

if nargin < 4
    signalToUse = 'dFF';
end
%% Load Threshold Metrics from sessionROIData
outputFilePath = sessionFileInfo.otherSessFilePaths.sessionROIData;
if exist(outputFilePath, 'file') == 2
    fprintf('Loading significance and variance metrics from: %s\n', outputFilePath);
    
    % Load all necessary threshold metrics
    loadedMetrics = load(outputFilePath); 
    
    % 1/0 Significance Indices (Greater than 95th Percentile)
    peakSigIndex = loadedMetrics.nullDist_PeakTuningMetric.isSignificantByPeakShuffling.(signalToUse);
    rangeSigIndex = loadedMetrics.nullDist_RangeTuningMetric.isSignificantByRange.(signalToUse);
    
    % Raw Percentile Ranks (for display in text box)
    peakRankVal = loadedMetrics.nullDist_PeakTuningMetric.realPeakPercentileRank.(signalToUse);
    rangeRankVal = loadedMetrics.nullDist_RangeTuningMetric.realRangePercentileRank.(signalToUse);
    
    % Variance Metrics
    varToTuningVar = loadedMetrics.tuningCurveVariance.ratioVarToTuningVar;
    varToTuningRange = loadedMetrics.tuningCurveVariance;

    % Halves Correlation
    halvesCorrIdxRho = loadedMetrics.lapCorr_Halves.rho;
   
    % OddEven Correlation
    oddEvenCorrIdxRho = loadedMetrics.lapCorr_OddEven.rho; 
    
    % Correlation Kept (Map roisToKeep indices to a logical mask)
    roisToKeepMask = false(size(varToTuningVar));
    if isfield(loadedMetrics.highlyCorrBoutons, 'roisToKeep')
        roisToKeepMask(loadedMetrics.highlyCorrBoutons.roisToKeep) = true;
    end
    
    metricsLoaded = true;
else
    warning('sessionROIData file not found. Threshold metrics will not be displayed.');
    metricsLoaded = false;
end

%% Output path setup
figSaveDir = fullfile(sessionFileInfo.Directories.save_folder, 'Figures');
if ~exist(figSaveDir, 'dir')
    mkdir(figSaveDir);
end
pdfName = sprintf('%s_%s_AllROIs_%s_dFF_THRESHOLDED.pdf', ...
    sessionFileInfo.animal_name, ...
    sessionFileInfo.session_name, ...
    response.stimName);
pdfPath = fullfile(figSaveDir, pdfName);

% Delete existing PDF to prevent appending to old data
if exist(pdfPath, 'file'), delete(pdfPath); end

%% Extract activity
lapActivityFull = response.lapPositionActivity.(signalToUse);
nROIs = size(lapActivityFull, 1);
fprintf('Generating ROI summary plots for %d ROIs...\n', nROIs);

% Define criteria thresholds 
THRESHOLD_VAR_TO_VAR = 20; 
THRESHOLD_VAR_TO_RANGE = 1; 
THRESHOLD_HALVES_CORR = 0.4;
THRESHOLD_ODDEVEN_CORR = 0.4;


% Initialize counter for ROIs that pass all criteria
totalROIsPassingAll = 0;

%% Loop through all ROIs and Plot
for neuronIdx = 1:nROIs
    roiActivity = squeeze(lapActivityFull(neuronIdx, :, :)); % laps x bins
    if all(isnan(roiActivity), 'all')
        continue;
    end
    
    if applySmoothing
        w = gausswin(5); w = w / sum(w);
        for iLap = 1:size(roiActivity, 1)
            trace = roiActivity(iLap, :);
            if all(isnan(trace)), continue; end
            nanMask = isnan(trace);
            trace(nanMask) = 0;
            smoothed = filtfilt(w, 1, trace);
            smoothed(nanMask) = NaN;
            roiActivity(iLap, :) = smoothed;
        end
    end
    
    % Compute mean ± SEM
    meanActivity = mean(roiActivity, 1, 'omitnan');
    semActivity = std(roiActivity, 0, 1, 'omitnan') ./ sqrt(sum(~isnan(roiActivity), 1));
    % Normalize lap heatmap for visualization
    normLapActivity = normalize(roiActivity, 2, 'range');
    
    % Create figure
    fig = figure('Visible', 'off', 'Position', [100 100 1200 400]);
    
    % --- THRESHOLD CHECK AND TITLE SETUP ---
    if metricsLoaded
        % Get metrics for current ROI
        isPeakSig = peakSigIndex(neuronIdx);
        isRangeSig = rangeSigIndex(neuronIdx);
        pRank = peakRankVal(neuronIdx);
        rRank = rangeRankVal(neuronIdx);
        varToVarVal = varToTuningVar(neuronIdx);
        varToRangeVal = varToTuningRange(neuronIdx); 
        halvesRho = halvesCorrIdxRho(neuronIdx);
        oddEvenRho = oddEvenCorrIdxRho(neuronIdx);
        isBoutonKept = roisToKeepMask(neuronIdx); 
        
        % Quality Checks
        isTuningQualityPass = (varToVarVal <= THRESHOLD_VAR_TO_VAR);
        isRangeQualityPass = varToRangeVal <= THRESHOLD_VAR_TO_RANGE;
        isHalvesSig = halvesRho >= THRESHOLD_HALVES_CORR;
        isOddEvenSig = oddEvenRho >= THRESHOLD_ODDEVEN_CORR;
        
        % Define overall status: (Significant by either shuffle) AND (Variance Check) AND (Correlation Kept)
        passesAllCriteria = (isPeakSig || isRangeSig) && isTuningQualityPass && isRangeQualityPass && isBoutonKept && isHalvesSig && isOddEvenSig;
        
        if passesAllCriteria
            totalROIsPassingAll = totalROIsPassingAll + 1;
            titleColor = [0 0.5 0]; % Green
            statusStr = 'All criteria met';
        else
            titleColor = [0.8 0 0]; % Red
            statusStr = 'Not all criteria met';
        end
        
        % Detailed text box: Includes 1/0 status and the raw percentile rank in parentheses
        detailText = {
            sprintf('Peak Shuff Sig (>95): %d ', isPeakSig), 
            sprintf('Range Shuff Sig (>95): %d ', isRangeSig), 
            sprintf('Var/TuningVar (<=%.1f): %.2f (%d)', THRESHOLD_VAR_TO_VAR, varToVarVal, isTuningQualityPass),
            sprintf('Var/TuningRange (<=%.1f): %.2f (%d)', THRESHOLD_VAR_TO_RANGE, varToRangeVal, isRangeQualityPass), 
            sprintf('Correlation Kept: %d', isBoutonKept),
            sprintf('Halves Corr (>=%.1f): %.2f (%d)', THRESHOLD_HALVES_CORR, halvesRho, isHalvesSig),
            sprintf('Var/TuningRange (>=%.1f): %.2f (%d)', THRESHOLD_ODDEVEN_CORR, oddEvenRho, isOddEvenSig), 
        };
        
        mainTitle = sprintf('ROI %d: %s', neuronIdx, statusStr);
    else
        mainTitle = sprintf('ROI %d: METRICS NOT LOADED', neuronIdx);
        titleColor = [0 0 0];
    end
    
    % --- Line plot (Mean Activity) ---
    subplot(1, 2, 1); hold on;
    x = 1:size(meanActivity, 2);
    fill([x fliplr(x)], ...
         [meanActivity + semActivity, fliplr(meanActivity - semActivity)], ...
         [0.7 0.7 0.7], 'EdgeColor', 'none', 'FaceAlpha', 0.5);
    plot(x, meanActivity, 'k', 'LineWidth', 2);
    xline(50, 'k--'); xline(70, 'k--'); xline(90, 'k--'); xline(110, 'k--');
    xticks([0 50 70 90 110 140]);
    xlabel('Position (cm)'); ylabel('Mean dFF');
    title(mainTitle, 'Color', titleColor);
    
    if metricsLoaded
        dim = [0.15 0.5 0.2 0.4];
        annotation('textbox', dim, 'String', detailText, 'FitBoxToText', 'on', ...
                   'BackgroundColor', [1 1 1], 'EdgeColor', [0.8 0.8 0.8], 'Interpreter', 'none', 'FontSize', 9);
    end
    box off; set(gca, 'FontSize', 12);
    
    % --- Heatmap (Lap-by-Position) ---
    subplot(1, 2, 2);
    imagesc(normLapActivity);
    caxis([0 1]); colormap(flipud(gray));
    xline(50, 'k--'); xline(70, 'k--'); xline(90, 'k--'); xline(110, 'k--');
    xticks([0 50 70 90 110 140]);
    xlabel('Position (cm)'); ylabel('Lap #');
    title('Lap-by-position activity (normalized)');
    colorbar; ylabel(colorbar, 'Normalized Activity');
    set(gca, 'TickDir', 'out', 'box', 'off', 'FontSize', 12, 'YDir', 'normal');
    
    % Save current page to multi-page PDF
    exportgraphics(fig, pdfPath, 'Append', true);
    close(fig);
end

%% Final Summary Printout
if metricsLoaded && nROIs > 0
    validROIs = nROIs - sum(all(isnan(lapActivityFull), [2 3])); 
    overallPercentage = (totalROIsPassingAll / validROIs) * 100;
    
    fprintf('\n======================================================\n');
    fprintf('OVERALL ROI SUMMARY:\n');
    fprintf('ROIs passing ALL criteria: %d / %d\n', totalROIsPassingAll, validROIs);
    fprintf('Success Rate: %.2f%%\n', overallPercentage);
    fprintf('======================================================\n');
end

fprintf('Done. All ROI plots saved to:\n%s\n', pdfPath);
end