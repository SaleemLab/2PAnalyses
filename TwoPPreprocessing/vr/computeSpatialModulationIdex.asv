function [sessionFileInfo, response] = computeSpatialModulationIdex(sessionFileInfo, VRStimName, applySmoothing, excludeFlaggedLaps)
% Compute on base trials only
% 
if nargin < 2
   error('Must provide the response struct.');
end
if nargin < 3
    applySmoothing = true; 
end

if nargin < 4
    excludeFlaggedLaps = false;
end 

stimIdx = find(strcmp(VRStimName, {sessionFileInfo.stimFiles.name}));
if isempty(stimIdx)
    error('Specified VRStimName ''%s'' not found in sessionFileInfo.', VRStimName);
end

response = load(sessionFileInfo.stimFiles(stimIdx).Response, 'lapPositionActivity', 'trialIndicesByCondition', 'stimName', 'flaggedLaps');

partnerLandmarkPosition = 80;   
excludeStart = 30; 
excludeEnd = 30;

signalNames = fieldnames(response.lapPositionActivity);

disp('Computing SMI for this session...\n');
SMI = struct(); 
SMI_Metrics = struct();

for iSignal = 1:length(signalNames)
    currentSignalName = signalNames{iSignal};
    disp(['Processing signal: ', currentSignalName]);
    
    lapActivity = response.lapPositionActivity.(currentSignalName); 
    baseTrials = response.trialIndicesByCondition.Baseline;

    % Remove flagged laps [over 50% of frames in a lab were labelled 'bad']
    if excludeFlaggedLaps && isfield(response, 'flaggedLaps') && ~isempty(response.flaggedLaps)
        overlappingLaps = intersect(baseTrials, response.flaggedLaps);
        if ~isempty(overlappingLaps)
            fprintf('Excluding %d flagged baseline laps before computing metric...\n', length(overlappingLaps));
            % Remove any baseline trial index that appears in flaggedLaps
            baseTrials = setdiff(baseTrials, response.flaggedLaps);
        end
    end
    
    
    baseLapActivity = lapActivity(:, baseTrials, :);
    [numROIs, numLaps, numBins] = size(baseLapActivity);
    validLapPositionRange = (excludeStart + 1) : (numBins - excludeEnd);
    
    if applySmoothing
        w = gausswin(15); w = w / sum(w);
        for iCell = 1:numROIs
            for iLap = 1:numLaps
                trace = squeeze(baseLapActivity(iCell, iLap, :));
                if all(isnan(trace)), continue; end
                nanMask = isnan(trace);
                trace(nanMask) = 0;
                smoothed = filtfilt(w, 1, trace);
                smoothed(nanMask) = NaN;
                baseLapActivity(iCell, iLap, :) = smoothed;
            end
        end
    end
    
    meanOdd = squeeze(mean(baseLapActivity(:, 1:2:end, :), 2, 'omitnan'));
    meanEven = squeeze(mean(baseLapActivity(:, 2:2:end, :), 2, 'omitnan'));
    
    smiValues = NaN(numROIs, 1);
    rpValues  = NaN(numROIs, 1);
    rnValues  = NaN(numROIs, 1);
    peakBins  = NaN(numROIs, 1);
    
    trackBins = struct();
    trackBins.prefBin = zeros(numROIs, 1);
    trackBins.partnerBins = cell(numROIs, 1);
    
    for thsROI = 1:numROIs
        roiTrace = meanOdd(thsROI, :);
        [pks, locs] = findpeaks(roiTrace);
        
        validPeakMask = ismember(locs, validLapPositionRange);
        validPks = pks(validPeakMask);
        validLocs = locs(validPeakMask);
        
        if ~isempty(validLocs)
            [~, maxPeakIdx] = max(validPks);
            prefBin = validLocs(maxPeakIdx);
        else
            [~, maxRelIdx] = max(roiTrace(validLapPositionRange));
            prefBin = validLapPositionRange(maxRelIdx);
        end
        
        trackBins.prefBin(thsROI) = prefBin;
        peakBins(thsROI) = prefBin;
        
        Rp = max(0, meanEven(thsROI, prefBin));
        rpValues(thsROI) = Rp;
        
        if prefBin <= 100
            targetPartner = prefBin + partnerLandmarkPosition; 
        else
            targetPartner = prefBin - partnerLandmarkPosition; 
        end
        
        if targetPartner >= 1 && targetPartner <= numBins
            matchingBin = targetPartner;
            trackBins.partnerBins{thsROI} = matchingBin;
            Rn = max(0, meanEven(thsROI, matchingBin));
            rnValues(thsROI) = Rn;
        else
            continue; 
        end
        
        % if (Rp + Rn) > 1e-9 
        smiValues(thsROI) = (Rp - Rn) / (Rp + Rn);
        % else
        %     smiValues(thsROI) = NaN; 
        % end
    end
    SMI.(currentSignalName) = smiValues;
    
    SMI_Metrics.(currentSignalName).SMI = smiValues;
    SMI_Metrics.(currentSignalName).Rp = rpValues;
    SMI_Metrics.(currentSignalName).Rn = rnValues;
    SMI_Metrics.(currentSignalName).PeakBinPosition = peakBins;
    
    validSMIIdx = find(~isnan(smiValues));
    if ~isempty(validSMIIdx)
        qVals = quantile(smiValues(validSMIIdx), [0.25, 0.50, 0.75]);
        quantROIs = zeros(1, 3);
        for q = 1:3
            [~, minIdx] = min(abs(smiValues(validSMIIdx) - qVals(q)));
            quantROIs(q) = validSMIIdx(minIdx);
        end
        qLabels = {'low smi (25th pct)', 'median smi (50th pct)', 'high smi (75th pct)'};
        figure('Name', ['example rois for ' currentSignalName], 'Color', [1 1 1], 'Position', [100 100 1200 400]);
        for iPlot = 1:3
            targetROI = quantROIs(iPlot);
            subplot(1, 3, iPlot); hold on;
            yLims = selectYLim(meanOdd(targetROI,:), meanEven(targetROI,:));
            
            plot(1:numBins, meanOdd(targetROI, :), 'Color', [0.824, 0.016, 0.176], 'LineWidth', 2, 'DisplayName', 'mean odd laps');
            plot(1:numBins, meanEven(targetROI, :), 'Color', [0.000, 0.400, 1.000], 'LineWidth', 2, 'DisplayName', 'mean even laps');
            
            pBin = trackBins.prefBin(targetROI);
            partBins = trackBins.partnerBins{targetROI};
            plot(pBin, meanEven(targetROI, pBin), 'ro', 'MarkerFaceColor', 'r', 'MarkerSize', 8, 'DisplayName', 'Rp (pref bin)');
            if ~isempty(partBins)
                plot(partBins, meanEven(targetROI, partBins), 'bo', 'MarkerFaceColor', 'b', 'MarkerSize', 8, 'DisplayName', 'Rn (partner bins)');
            end
            title(sprintf('%s\nroi %d (smi: %.2f)', qLabels{iPlot}, targetROI, smiValues(targetROI)), 'Interpreter', 'none');
            xlabel('spatial position bins');
            ylabel('activity');
            ylim(yLims);
            grid on;
            if iPlot == 3, legend('Location', 'best'); end
        end
    end
end

disp('smi calculation complete.');
disp(['appending variable SMI_Metrics to file: ', sessionFileInfo.stimFiles(stimIdx).Response]);
save(sessionFileInfo.stimFiles(stimIdx).Response, 'SMI_Metrics', '-append');
save(sessionFileInfo.sessionFileInfo_filepath, 'sessionFileInfo');
disp('Done.');

figure('Name', 'spatial modulation index summary', 'Color', [1 1 1]);
numSignals = length(signalNames);
subplot(1, 2, 1); hold on;
plotGroupData = []; plotGroupLabels = {};
for iSignal = 1:numSignals
    sigName = signalNames{iSignal};
    vals = SMI.(sigName)(~isnan(SMI.(sigName)));
    if ~isempty(vals)
        jitter = (rand(size(vals)) - 0.5) * 0.15 + iSignal;
        scatter(jitter, vals, 25, [0.5, 0.5, 0.5], 'filled', 'MarkerFaceAlpha', 0.4);
        plotGroupData = [plotGroupData; vals]; 
        labels = repmat({sigName}, length(vals), 1);
        plotGroupLabels = [plotGroupLabels; labels];
    end
end
if ~isempty(plotGroupData), boxplot(plotGroupData, plotGroupLabels, 'Widths', 0.4, 'Colors', 'k'); end
ylabel('spatial modulation index (smi)'); title('smi distribution per signal type'); ylim([-1.1, 1.1]); grid on;

subplot(1, 2, 2); hold on;
for iSignal = 1:numSignals
    sigName = signalNames{iSignal};
    vals = SMI.(sigName)(~isnan(SMI.(sigName)));
    if ~isempty(vals)
        [f, x] = ecdf(vals);
        plot(x, f, 'LineWidth', 2.5, 'DisplayName', sigName);
    end
end
xlabel('smi value'); ylabel('cumulative proportion'); title('cumulative distribution function');
legend('Location', 'best', 'Interpreter', 'none'); xlim([-1.1, 1.1]); ylim([0, 1]); grid on;
drawnow;
end

function yLimits = selectYLim(traceA, traceB)
    mx = max([traceA, traceB]);
    mn = min([traceA, traceB]);
    rangeVal = mx - mn;
    if rangeVal <= 1e-9, rangeVal = 1; end
    yLimits = [mn - 0.1*rangeVal, mx + 0.1*rangeVal];
end

