% DotFields_IncTuningCurveAnalysis_RunningOnly_2PData.m
%
% Running-only version of DotFields_IncTuningCurveAnalysis_compareStatesV2_2PData.m
% Trials are filtered to LOCOMOTION ONLY at classification time, so there
% is no stationary/running split to carry through -- alltraces is
% [nSpeeds x 1], and every downstream step (ANOVA, t-test/Wilcoxon,
% reliability, cross-validated R^2, Gaussian fit, dynamic range/Fano
% factor) runs once instead of twice.
%
% Requires calc_kfold_R2.m and fitGaussianTemplates_tuning.m

%%
mouseList = {'M25132', 'M25133', 'M26003'};

stimWindowMask_range  = [0.1 3];
stimFramesMask_range  = [-0.2 2.8];

runSpeedThresh  = 3;
statSpeedThresh = 0.5;
propThresh      = 0.75;

ALPHA = 0.05;
NSD   = 1;

r2opts.kval       = 3;
r2opts.nPerms     = 10;
r2opts.randFlag   = 1;
r2opts.validMeans = 1;
r2opts.nShuffle   = 100;

options.binSpacing = 2.0;

%%
filteredTable = filterMasterTable('MouseID', mouseList, 'HasStimulus', 'DotMotion_SpeedTuning', ...
    'Suite2PPreprocessing', 1, 'Exclude', 0);
allMice    = filteredTable.MouseID;
uniqueMice = unique(allMice, 'stable');

allDotUnits = struct('alltraces', {}, 'preStimTrials', {}, 'blankTrials', {}, 'tuning', {}, ...
    'preStimBaselineMean', {}, 'preStimBaselineSEM', {}, 'evokedVals_ordered', {}, 'preStimVals_ordered', {}, ...
    'sessionLabel', {}, 'mouseID', {}, 'sessionName', {}, 'roiIdx', {});
haveWarnedShape = false;

for iMouse = 1:length(uniqueMice)
    thisMouse    = uniqueMice{iMouse};
    mouseSessIdx = find(strcmp(allMice, thisMouse));
    fprintf('MOUSE: %s | %d sessions\n', thisMouse, length(mouseSessIdx));

    for iSess = 1:length(mouseSessIdx)
        tableRow        = filteredTable(mouseSessIdx(iSess), :);
        thisSessionName = char(tableRow.Session);

        fprintf('  --- Session: %s ---\n', thisSessionName);

        infoPath = findSessionFileInfoFilePath(thisMouse, thisSessionName);
        if ~isfile(infoPath), warning('    sfi missing -- skipping.'); continue; end
        loadedInfo      = load(infoPath, 'sessionFileInfo');
        sessionFileInfo = loadedInfo.sessionFileInfo;
        stimNames       = {sessionFileInfo.stimFiles.name};
        dotIdx = find(contains(stimNames, 'DotMotion_SpeedTuning'), 1);
        if isempty(dotIdx), warning('    No DotMotion_SpeedTuning file -- skipping.'); continue; end

        try
            load(sessionFileInfo.stimFiles(dotIdx).Response, 'response');
            load(sessionFileInfo.stimFiles(dotIdx).BonsaiData, 'bonsaiData');
        catch ME
            warning('    Could not load response/bonsaiData: %s', ME.message); continue;
        end
        if ~isfield(response, 'wheelData') || ~isfield(response, 'psthData')
            warning('    Missing wheelData or psthData -- skipping.'); continue;
        end

        %% build trial list, classify running/stationary, KEEP RUNNING ONLY
        nGroups = numel(response.wheelData);
        trialsSpeed2D = struct('VelX1', {}, 'numDots1', {}, 'runFlag', {}, ...
                                'origGroup', {}, 'origTrialInGroup', {});
        trialCounter = 1;

        for g = 1:nGroups
            grpWheel  = response.wheelData(g);
            grpBonsai = bonsaiData.trialGroups(g);

            speedMatrix = grpWheel.alignedResponses;
            tVec        = grpWheel.timeVector;
            stimFramesMask = (tVec >= stimFramesMask_range(1) & tVec <= stimFramesMask_range(2));

            for ti = 1:size(speedMatrix, 2)
                singleTrialTrace = speedMatrix(:, ti);
                if all(isnan(singleTrialTrace)), continue; end

                meanSpeed      = nanmean(singleTrialTrace(stimFramesMask));
                propRunning    = sum(singleTrialTrace(stimFramesMask) > statSpeedThresh) / sum(stimFramesMask);

                runFlag = NaN;
                if propRunning >= propThresh && meanSpeed > runSpeedThresh
                    runFlag = 1;
                end
                if isnan(runFlag) || runFlag ~= 1, continue; end % KEEP RUNNING TRIALS ONLY

                trialsSpeed2D(trialCounter).VelX1 = grpWheel.stimValue;
                if grpWheel.stimValue == 1
                    trialsSpeed2D(trialCounter).numDots1 = 0; % blank
                else
                    trialsSpeed2D(trialCounter).numDots1 = 573;
                end
                trialsSpeed2D(trialCounter).runFlag          = runFlag;
                trialsSpeed2D(trialCounter).origGroup        = g;
                trialsSpeed2D(trialCounter).origTrialInGroup = ti;

                trialCounter = trialCounter + 1;
            end
        end

        if trialCounter == 1
            warning('    No valid running trials for %s -- skipping.', thisSessionName);
            continue;
        end

        tsd = trialsSpeed2D;
        temp_tsd  = tsd([tsd.numDots1] == 573); % real (non-blank) running trials
        blank_tsd = tsd([tsd.numDots1] == 0);   % blank running trials

        if isempty(temp_tsd)
            warning('    No non-blank running trials for %s -- skipping.', thisSessionName);
            continue;
        end
        if isempty(blank_tsd)
            warning('    No blank running trials for %s -- blank-dependent stats will be NaN.', thisSessionName);
        end

        uniqueVelocities = unique(abs([temp_tsd.VelX1]));
        nSpeeds = numel(uniqueVelocities);

        nBoutons = size(response.psthData(1).alignedResponses, 1);
        if ~haveWarnedShape
            fprintf('    Detected shape: %d boutons x %d timepoints x %d trials (group 1)\n', ...
                size(response.psthData(1).alignedResponses,1), ...
                size(response.psthData(1).alignedResponses,2), ...
                size(response.psthData(1).alignedResponses,3));
            haveWarnedShape = true;
        end

        timeVec = response.psthData(1).timeVector(:)';
        stimWindowMask = timeVec >= stimWindowMask_range(1) & timeVec <= stimWindowMask_range(2);
        preStimWindow_range = [-0.75, -0.2]; % pre-stim baseline window, avoids previous-trial calcium decay
        preStimMask = timeVec >= preStimWindow_range(1) & timeVec <= preStimWindow_range(2);

        %% per-bouton, running trials only (no state dimension)
        for thisROI = 1:nBoutons
            alltraces     = cell(nSpeeds, 1);
            preStimTrials = cell(nSpeeds, 1);
            blankTrials   = cell(1, 1);

            for thisSpeed = 1:nSpeeds
                matchingTrials = find(abs([temp_tsd.VelX1]) == uniqueVelocities(thisSpeed));
                traceAccumulator      = nan(1, numel(matchingTrials));
                preStimAccumulator    = nan(1, numel(matchingTrials));
                for mt = 1:numel(matchingTrials)
                    origGroup = temp_tsd(matchingTrials(mt)).origGroup;
                    origTi    = temp_tsd(matchingTrials(mt)).origTrialInGroup;
                    fullTrace = squeeze(response.psthData(origGroup).alignedResponses(thisROI, :, origTi));
                    traceAccumulator(mt)   = nanmean(fullTrace(stimWindowMask));
                    preStimAccumulator(mt) = nanmean(fullTrace(preStimMask));
                end
                alltraces{thisSpeed}     = traceAccumulator;
                preStimTrials{thisSpeed} = preStimAccumulator;
            end

            blankAccum = nan(1, numel(blank_tsd));
            for mt = 1:numel(blank_tsd)
                origGroup = blank_tsd(mt).origGroup;
                origTi    = blank_tsd(mt).origTrialInGroup;
                fullTrace = squeeze(response.psthData(origGroup).alignedResponses(thisROI, :, origTi));
                blankAccum(mt) = nanmean(fullTrace(stimWindowMask));
            end
            blankTrials{1} = blankAccum;

            evokedVals_ordered  = nan(1, numel(temp_tsd));
            preStimVals_ordered = nan(1, numel(temp_tsd));
            for i = 1:numel(temp_tsd)
                fullTraceOrdered = squeeze(response.psthData(temp_tsd(i).origGroup).alignedResponses(thisROI, :, temp_tsd(i).origTrialInGroup));
                evokedVals_ordered(i)  = nanmean(fullTraceOrdered(stimWindowMask));
                preStimVals_ordered(i) = nanmean(fullTraceOrdered(preStimMask));
            end

            allDotUnits(end+1) = struct( ...
                'alltraces',     {alltraces}, ...
                'preStimTrials', {preStimTrials}, ...
                'blankTrials',   {blankTrials}, ...
                'tuning',        cellfun(@nanmean, alltraces), ...
                'preStimBaselineMean', nanmean([preStimTrials{:}]), ...
                'preStimBaselineSEM',  nanstd([preStimTrials{:}]) / sqrt(sum(~isnan([preStimTrials{:}]))), ...
                'evokedVals_ordered',  evokedVals_ordered, ...
                'preStimVals_ordered', preStimVals_ordered, ...
                'sessionLabel',  sprintf('%s_%s', thisMouse, thisSessionName), ...
                'mouseID',       thisMouse, ...
                'sessionName',   thisSessionName, ...
                'roiIdx',        thisROI); %
        end
        fprintf('    Added %d boutons (running total: %d).\n', nBoutons, numel(allDotUnits));
    end
end

nBoutonsTotal = numel(allDotUnits);
fprintf('\nDone pooling. %d boutons total across %d mice (RUNNING trials only).\n', nBoutonsTotal, numel(uniqueMice));

%% ANOVA(speeds+blank) + 2SD-above-blank threshold
anovaP_thresh    = nan(nBoutonsTotal, 1);
blankMean        = nan(nBoutonsTotal, 1);
blankSD          = nan(nBoutonsTotal, 1);
meanPreferredRaw = nan(nBoutonsTotal, 1);
prefSpeedIdx     = nan(nBoutonsTotal, 1);
isResponsive     = false(nBoutonsTotal, 1);

for thisBouton = 1:nBoutonsTotal
    alltraces   = allDotUnits(thisBouton).alltraces;
    blankTrials = allDotUnits(thisBouton).blankTrials{1}(:);
    blankTrials = blankTrials(~isnan(blankTrials));
    nSpeeds = numel(alltraces);

    y = []; grp = [];
    for thisSpeed = 1:nSpeeds
        vals = alltraces{thisSpeed}(:);
        vals = vals(~isnan(vals));
        y   = [y; vals];
        grp = [grp; repmat(thisSpeed, numel(vals), 1)];
    end
    y   = [y;   blankTrials];
    grp = [grp; repmat(nSpeeds + 1, numel(blankTrials), 1)];

    if numel(y) < (nSpeeds + 1) * 2 || isempty(blankTrials)
        continue;
    end
    anovaP_thresh(thisBouton) = anova1(y, grp, 'off');
    blankMean(thisBouton) = mean(blankTrials);
    blankSD(thisBouton)   = std(blankTrials);

    tuningThisState = cellfun(@(x) mean(x, 'omitnan'), alltraces);
    [~, prefSpeedIdx(thisBouton)] = max(tuningThisState);
    meanPreferredRaw(thisBouton) = mean(alltraces{prefSpeedIdx(thisBouton)}, 'omitnan');

    isResponsive(thisBouton) = (anovaP_thresh(thisBouton) < ALPHA) && ...
                      (meanPreferredRaw(thisBouton) > blankMean(thisBouton) + NSD * blankSD(thisBouton));
end

fprintf('\n%d / %d boutons responsive (ANOVA[speeds+blank]+threshold, p<%.2f, >%dSD above blank).\n', ...
    sum(isResponsive), nBoutonsTotal, ALPHA, NSD);

for thisBouton = 1:nBoutonsTotal
    allDotUnits(thisBouton).anovaP_thresh_run    = anovaP_thresh(thisBouton);
    allDotUnits(thisBouton).blankMean_run        = blankMean(thisBouton);
    allDotUnits(thisBouton).blankSD_run          = blankSD(thisBouton);
    allDotUnits(thisBouton).meanPreferredRaw_run = meanPreferredRaw(thisBouton);
    allDotUnits(thisBouton).prefSpeedIdx_run     = prefSpeedIdx(thisBouton);
    allDotUnits(thisBouton).isResponsive_run     = isResponsive(thisBouton);
end

%% ANOVA-protected t-test / Wilcoxon vs blank
ttestP    = nan(nBoutonsTotal, 1);
ranksumP  = nan(nBoutonsTotal, 1);
isResp_ttest   = false(nBoutonsTotal, 1);
isResp_ranksum = false(nBoutonsTotal, 1);

for thisBouton = 1:nBoutonsTotal
    anovaP_thresh_b = allDotUnits(thisBouton).anovaP_thresh_run;
    prefSpeedIdx_b  = allDotUnits(thisBouton).prefSpeedIdx_run;
    if isnan(anovaP_thresh_b) || isnan(prefSpeedIdx_b)
        continue;
    end

    prefTrials  = allDotUnits(thisBouton).alltraces{prefSpeedIdx_b}(:);
    prefTrials  = prefTrials(~isnan(prefTrials));
    blankTrials = allDotUnits(thisBouton).blankTrials{1}(:);
    blankTrials = blankTrials(~isnan(blankTrials));

    if numel(prefTrials) < 2 || numel(blankTrials) < 2
        continue;
    end

    [~, ttestP(thisBouton)] = ttest2(prefTrials, blankTrials, 'Vartype', 'unequal');
    ranksumP(thisBouton) = ranksum(prefTrials, blankTrials);

    blankMean_b = allDotUnits(thisBouton).blankMean_run;
    meanPreferredRaw_b = allDotUnits(thisBouton).meanPreferredRaw_run;

    isResp_ttest(thisBouton)   = (anovaP_thresh_b < ALPHA) && (ttestP(thisBouton) < ALPHA) && (meanPreferredRaw_b > blankMean_b);
    isResp_ranksum(thisBouton) = (anovaP_thresh_b < ALPHA) && (ranksumP(thisBouton) < ALPHA) && (meanPreferredRaw_b > blankMean_b);
end

fprintf('%d / %d boutons responsive (ANOVA-protected Welch t-test, p<%.2f).\n', sum(isResp_ttest), nBoutonsTotal, ALPHA);
fprintf('%d / %d boutons responsive (ANOVA-protected Wilcoxon, p<%.2f).\n', sum(isResp_ranksum), nBoutonsTotal, ALPHA);

for thisBouton = 1:nBoutonsTotal
    allDotUnits(thisBouton).ttestP_run             = ttestP(thisBouton);
    allDotUnits(thisBouton).ranksumP_run           = ranksumP(thisBouton);
    allDotUnits(thisBouton).isResponsive_ttest_run   = isResp_ttest(thisBouton);
    allDotUnits(thisBouton).isResponsive_ranksum_run = isResp_ranksum(thisBouton);
end

%% cross-validated R^2 (running trials only)
runR2 = nan(nBoutonsTotal, 1); runR2_pval = nan(nBoutonsTotal, 1);
seed = 1;
runR2 = nan(nBoutonsTotal, 1); runR2_pval = nan(nBoutonsTotal, 1);
seed = 1;
for thisBouton = 1:nBoutonsTotal
    alltraces = allDotUnits(thisBouton).alltraces;

    minTrial = min(cellfun(@(x) sum(~isnan(x)), alltraces));
    if minTrial < nTrialsTarget
        continue;
    end
    gca_run = cellfun(@(x) x(find(~isnan(x), nTrialsTarget)), alltraces, 'UniformOutput', false)';
    [runR2(thisBouton), runR2_pval(thisBouton)] = calc_kfold_R2(gca_run, r2opts.kval, r2opts.nPerms, ...
        r2opts.randFlag, r2opts.validMeans, r2opts.nShuffle, seed);
    if mod(thisBouton, 100) == 0
        fprintf('Cross-val R^2: %d / %d boutons...\n', thisBouton, nBoutonsTotal);
    end
end

isTunedRun = runR2_pval < ALPHA;
fprintf('\n%d / %d boutons show significant cross-validated tuning (p<%.2f).\n', ...
    sum(isTunedRun, 'omitnan'), nBoutonsTotal, ALPHA);

for thisBouton = 1:nBoutonsTotal
    allDotUnits(thisBouton).runR2      = runR2(thisBouton);
    allDotUnits(thisBouton).runR2_pval = runR2_pval(thisBouton);
    allDotUnits(thisBouton).isTunedRun = isTunedRun(thisBouton);
end

r2_thresh  = 0.1;
r2p_thresh = 0.05;
validIdx_run = find(cat(1,allDotUnits.runR2) > r2_thresh & cat(1,allDotUnits.runR2_pval) < r2p_thresh);
fprintf('\n%d / %d boutons pass R^2 filter (R^2>%.2f, p<%.2f).\n', numel(validIdx_run), nBoutonsTotal, r2_thresh, r2p_thresh);

%% Gaussian tuning-curve fits (running trials only)
gaussParams_all = repmat({nan(1,4)}, nBoutonsTotal, 1);
gaussChar_all   = nan(nBoutonsTotal, 1);
gaussR2_all     = nan(nBoutonsTotal, 1);
prefSpeed_all   = nan(nBoutonsTotal, 1);

for thisBouton = 1:nBoutonsTotal
    alltraces = allDotUnits(thisBouton).alltraces;
    tuning    = allDotUnits(thisBouton).tuning;

    alltracesClean = cellfun(@(x) x(~isnan(x)), alltraces, 'UniformOutput', false);
    if any(cellfun(@isempty, alltracesClean(:)))
        continue;
    end

    [gp, gc, gr2] = fitGaussianTemplates_tuning(alltracesClean, 0.5, false);
    if gc == 4, [~, ps] = min(tuning); else, [~, ps] = max(tuning); end

    gaussParams_all{thisBouton} = gp;
    gaussChar_all(thisBouton)   = gc;
    gaussR2_all(thisBouton)     = gr2;
    prefSpeed_all(thisBouton)   = ps;

    if mod(thisBouton, 100) == 0
        fprintf('Gaussian fits: %d / %d boutons...\n', thisBouton, nBoutonsTotal);
    end
end

for thisBouton = 1:nBoutonsTotal
    allDotUnits(thisBouton).gaussParams_run = gaussParams_all{thisBouton};
    allDotUnits(thisBouton).gaussChar_run   = gaussChar_all(thisBouton);
    allDotUnits(thisBouton).gaussR2_run     = gaussR2_all(thisBouton);
    allDotUnits(thisBouton).prefSpeed_run   = prefSpeed_all(thisBouton);
end

%% dynamic range and Fano factor
for thisBouton = 1:nBoutonsTotal
    alltraces = allDotUnits(thisBouton).alltraces;
    tuning    = allDotUnits(thisBouton).tuning;

    allDotUnits(thisBouton).dynamicRange_run = range(tuning) / options.binSpacing;
    allDotUnits(thisBouton).fanoFactor_run   = mean(cellfun(@(x) var(x)/mean(x), alltraces), 1);
end

%% descriptive summaries (R^2-filtered)
gaussChar_run    = cat(1, allDotUnits.gaussChar_run);
prefSpeed_run    = cat(1, allDotUnits.prefSpeed_run);
dynamicRange_run = cat(1, allDotUnits.dynamicRange_run);
fanoFactor_run    = cat(1, allDotUnits.fanoFactor_run);

figure('Position', [100 100 1000 700]);

subplot(2,2,1);
histogram(gaussChar_run(validIdx_run), 'BinMethod', 'integers');
xlabel('Gaussian tuning category (gaussChar_run)'); ylabel('Count');
title('Tuning shape category');

subplot(2,2,2);
histogram(prefSpeed_run(validIdx_run), 'BinMethod', 'integers');
xlabel('Preferred speed index'); ylabel('Count');
title('Preferred speed distribution');

subplot(2,2,3);
histogram(dynamicRange_run(validIdx_run));
xlabel('Dynamic range'); ylabel('Count');
title('Dynamic range distribution');

subplot(2,2,4);
histogram(fanoFactor_run(validIdx_run));
xlabel('Fano factor'); ylabel('Count');
title('Fano factor distribution');

sgtitle(sprintf('Descriptive tuning summaries [Locomotion only] (R^2-filtered, n=%d)', numel(validIdx_run)));

%% example Gaussian fit overlays (running trials only)
if ~isempty(validIdx_run)
    validIdxShuffled = validIdx_run(randperm(length(validIdx_run)));
    maxPlots = min(6, numel(validIdxShuffled));
    xDense = linspace(1, numel(allDotUnits(1).alltraces), 100);
    figure('Color', 'w', 'Name', 'Cross-Validated Gaussian Fit Overlays (Running)', 'Position', [100, 50, 1100, 800]);
    for iPlot = 1:maxPlots
        thisBouton = validIdxShuffled(iPlot);
        nSpeedsThis = numel(allDotUnits(thisBouton).alltraces);

        subplot(2,3,iPlot); hold on;
        y_data = allDotUnits(thisBouton).tuning / options.binSpacing;
        p = allDotUnits(thisBouton).gaussParams_run;
        y_fit = (p(1) + p(2)*exp(-((xDense-p(3)).^2)/(2*p(4)^2))) / options.binSpacing;

        plot(1:nSpeedsThis, y_data, 'ro', 'MarkerFaceColor','r','MarkerSize',5.5);
        plot(xDense, y_fit, 'r-', 'LineWidth', 2);

        allVals = [y_data(:); y_fit(:)];
        ylim([min(allVals)-0.03, max(allVals)+0.03]); xlim([0.5, nSpeedsThis+0.5]); xticks(1:nSpeedsThis);
        ylabel('\DeltaF/F'); xlabel('Visual Speed Index');
        title(sprintf('Bouton %d (%s)\nType %d, R^2=%.2f', thisBouton, allDotUnits(thisBouton).sessionLabel, ...
            allDotUnits(thisBouton).gaussChar_run, allDotUnits(thisBouton).gaussR2_run), 'FontSize', 9, 'Interpreter', 'none');
    end
    sgtitle('Gaussian Model Fits (Locomotion only, cross-validated cohort)', 'FontSize', 13, 'FontWeight', 'bold');
end
