% DirTuning_IncTuningCurveAnalysis_RunningOnly_2PData.m
%
% Running-only version of Figure5_3_DriftingGratings_basics.m, adapted
% to add the same wheel-based running/stationary trial classification
% used in DotFields_IncTuningCurveAnalysis_RunningOnly_2PData.m.
%
% Trials are classified and filtered to LOCOMOTION ONLY at pooling time
% (per direction, per trial), so downstream stats (ANOVA, t-test/
% Wilcoxon, cross-validated R^2) run once on running trials only -- no
% running/stationary split to carry through.
%
% ASSUMPTIONS ABOUT DATA SHAPE (please check against your actual
% response.mat -- these mirror the DotFields running-only script but
% DirTuning's raw file has not been inspected directly):
%   response.wheelData(d)  -- one entry PER DIRECTION, same length/order
%                              as response.psthData(d), i.e. wheelData(d)
%                              corresponds to the same direction group as
%                              psthData(d).
%   response.wheelData(d).alignedResponses : [nWheelSamples x nTrials]
%   response.wheelData(d).timeVector       : [nWheelSamples x 1]
%   Trial ti in wheelData(d) corresponds to trial ti in
%   psthData(d).alignedResponses(:, :, ti) (same trial ordering).
%
% If your wheelData is nested under bonsaiData.trialGroups instead (as
% in the DotFields loader), swap the loading block below accordingly --
% flagged with "ADJUST HERE" comments.
%
% Requires calc_kfold_R2.m, computeDirTuningOSI.m, computeDirTuningDSI.m

%%
runSpeedThresh  = 3;
statSpeedThresh = 0.5;
propThresh      = 0.75;

alpha  = 0.05;
numSD  = 1;

r2_thresh  = 0.1;
r2p_thresh = 0.05;

r2opts.kval       = 3;
r2opts.nPerms     = 10;
r2opts.randFlag   = 1;
r2opts.validMeans = 1;
r2opts.nShuffle   = 100;
seed = 1;

%%
DirTuningTable = filterMasterTable_usingNameSessionPairs('MouseID', ...
    {'M25132','M25133', 'M26003'}, 'Exclude', 0, 'HasStimulus', {'DirTuning'});
allMice    = DirTuningTable.MouseID;
uniqueMice = unique(allMice, 'stable');

% window definitions per timing variant (same as non-running script)
baseWin      = [-0.75 0];
respWin_2sOn = [0.1 3];   % postStimTime == 4 (2s-on/2s-off)
respWin_1sOn = [0.1 3];   % postStimTime == 3 (1s-on/2s-off)

allDirTuning     = struct('fullTraceSub', {}, 'timeVec', {}, ...
                           'stimOnDuration', {}, 'meanDirResponse', {}, ...
                           'trialMeanResp', {}, 'trialRawResp', {}, 'trialBaselineVals', {}, ...
                           'nTrialsRunPerDir', {}, ...
                           'stimValues', {}, 'stimVariant', {}, 'sessionLabel', {});
sessionLabels    = {};
haveWarnedShape  = false;

% keep a running tally of running-trial counts per direction across all
% sessions, purely for reporting how many trials survive the filter
sessionRunCounts = []; % [nSessions x nDir], NaN-padded if nDir varies

%% loop over mice and pool data (RUNNING TRIALS ONLY)
for iMouse = 1:length(uniqueMice)
    thisMouse    = uniqueMice{iMouse};
    mouseSessIdx = find(strcmp(allMice, thisMouse));
    fprintf('MOUSE: %s | %d sessions\n', thisMouse, length(mouseSessIdx));

    for iSess = 1:length(mouseSessIdx)
        tableRow        = DirTuningTable(mouseSessIdx(iSess), :);
        thisSessionName = char(tableRow.Session);
        fprintf('\n--- Session: %s ---\n', thisSessionName);

        infoPath = findSessionFileInfoFilePath(thisMouse, thisSessionName);
        if ~isfile(infoPath)
            warning('sfi missing for %s -- skipping.', thisSessionName);
            continue;
        end
        loadedInfo      = load(infoPath, 'sessionFileInfo');
        sessionFileInfo = loadedInfo.sessionFileInfo;
        stimNames       = {sessionFileInfo.stimFiles.name};
        DirTuneIdx = find(contains(stimNames, 'DirTuning'));
        if isempty(DirTuneIdx)
            warning('No DirTuning files for %s -- skipping.', thisSessionName);
            continue;
        end

        try
            load(sessionFileInfo.stimFiles(DirTuneIdx(1)).Response, 'response');
        catch ME
            warning('  Could not load response for %s: %s', thisSessionName, ME.message);
            continue;
        end
        if ~isfield(response, 'psthData') || isempty(response.psthData)
            warning('  psthData empty/missing for %s -- skipping.', thisSessionName);
            continue;
        end
        if ~isfield(response, 'wheelData') || isempty(response.wheelData)
            warning('  wheelData missing for %s -- cannot classify running trials -- skipping.', thisSessionName);
            continue;
        end

        switch response.postStimTime
            case 4
                respWin = respWin_2sOn; stimVariant = 4; stimOnDuration = 2;
            case 3
                respWin = respWin_1sOn; stimVariant = 3; stimOnDuration = 1;
            otherwise
                warning('  Unexpected postStimTime (%.2f) for %s -- skipping.', ...
                    response.postStimTime, thisSessionName);
                continue;
        end

        % running classification window: stim-on period plus a short
        % buffer, matching the intent of stimFramesMask_range in the
        % DotFields script. ADJUST if your rig's convention differs.
        stimFramesMask_range = [-0.2, stimOnDuration + 0.8];

        nDir      = numel(response.psthData);
        timeVec   = response.psthData(1).timeVector(:)';
        baseIdx   = timeVec >= baseWin(1) & timeVec <= baseWin(2);
        respIdx   = timeVec >= respWin(1) & timeVec <= respWin(2);
        stimVals  = arrayfun(@(s) s.stimValue, response.psthData);

        nBoutons = size(response.psthData(1).alignedResponses, 1);
        if ~haveWarnedShape
            fprintf('  Detected shape: %d boutons x %d timepoints x %d trials (dir 1)\n', ...
                size(response.psthData(1).alignedResponses,1), ...
                size(response.psthData(1).alignedResponses,2), ...
                size(response.psthData(1).alignedResponses,3));
            haveWarnedShape = true;
        end

        %% classify running trials per direction (KEEP RUNNING ONLY)
        % ADJUST HERE if wheelData is nested differently in your files.
        runTrialIdx      = cell(nDir, 1); % trial indices (into 3rd dim) classified as running, per direction
        nTrialsRunPerDir = nan(1, nDir);

        for thisDir = 1:nDir
            grpWheel    = response.wheelData(thisDir);
            speedMatrix = grpWheel.alignedResponses;      % [nWheelSamples x nTrials]
            tVecWheel   = grpWheel.timeVector(:)';
            stimFramesMask = tVecWheel >= stimFramesMask_range(1) & tVecWheel <= stimFramesMask_range(2);

            nTrialsThisDir = size(speedMatrix, 2);
            thisDirRunFlag = false(nTrialsThisDir, 1);

            for ti = 1:nTrialsThisDir
                singleTrialTrace = speedMatrix(:, ti);
                if all(isnan(singleTrialTrace)), continue; end

                meanSpeed   = nanmean(singleTrialTrace(stimFramesMask));
                propRunning = sum(singleTrialTrace(stimFramesMask) > statSpeedThresh) / sum(stimFramesMask);

                if propRunning >= propThresh && meanSpeed > runSpeedThresh
                    thisDirRunFlag(ti) = true;
                end
            end

            runTrialIdx{thisDir}       = find(thisDirRunFlag);
            nTrialsRunPerDir(thisDir)  = numel(runTrialIdx{thisDir});
        end

        fprintf('  Running trials per direction: %s\n', mat2str(nTrialsRunPerDir));

        if any(nTrialsRunPerDir == 0)
            warning('  At least one direction has zero running trials for %s -- skipping session.', thisSessionName);
            continue;
        end

        % pad/store for the population-level trial-count summary at the end
        if isempty(sessionRunCounts)
            sessionRunCounts = nTrialsRunPerDir;
        elseif size(sessionRunCounts, 2) == nDir
            sessionRunCounts = [sessionRunCounts; nTrialsRunPerDir]; %#ok<AGROW>
        else
            warning('  nDir (%d) differs from previous sessions -- skipping this session''s counts in the summary table (data itself is still pooled).', nDir);
        end

        %% per-bouton baseline subtraction + saving, RUNNING TRIALS ONLY
        for iBouton = 1:nBoutons
            fullTraceSub      = cell(nDir, 1);
            meanDirResponse   = nan(nDir, 1);
            trialMeanResp     = cell(nDir, 1);
            trialRawResp      = cell(nDir, 1);
            trialBaselineVals = cell(nDir, 1);

            for thisDir = 1:nDir
                traceMat = squeeze(response.psthData(thisDir).alignedResponses(iBouton, :, :));
                if isvector(traceMat)
                    traceMat = traceMat(:);
                end
                traceMat = double(traceMat)'; % [nTrials x nTimepoints]

                traceMat = traceMat(runTrialIdx{thisDir}, :); % KEEP RUNNING TRIALS ONLY

                % NO baseline subtraction here -- matches the DotFields
                % running-only convention (stim-window mean and
                % pre-stim/baseline mean kept as two separate RAW
                % quantities). perTrialBaseline is still computed since
                % it's needed as the "blank"-equivalent comparison for
                % the ANOVA/t-test/Wilcoxon responsiveness checks above
                % -- it's just never subtracted from the trace itself.
                perTrialBaseline = mean(traceMat(:, baseIdx), 2, 'omitnan');

                fullTraceSub{thisDir}    = traceMat; % NOTE: name kept for compatibility with plotExampleDirTuningBouton.m, but this is now the RAW trace (not baseline-subtracted)
                meanDirResponse(thisDir) = mean(mean(traceMat(:, respIdx), 2, 'omitnan'), 'omitnan');

                trialMeanResp{thisDir}     = mean(traceMat(:, respIdx), 2, 'omitnan'); % now identical to trialRawResp -- kept as a separate field for downstream compatibility
                trialRawResp{thisDir}      = mean(traceMat(:, respIdx), 2, 'omitnan');
                trialBaselineVals{thisDir} = perTrialBaseline;
            end

            allDirTuning(end+1) = struct( ...
                'fullTraceSub',       {fullTraceSub}, ...
                'timeVec',            timeVec, ...
                'stimOnDuration',     stimOnDuration, ...
                'meanDirResponse',    meanDirResponse, ...
                'trialMeanResp',      {trialMeanResp}, ...
                'trialRawResp',       {trialRawResp}, ...
                'trialBaselineVals',  {trialBaselineVals}, ...
                'nTrialsRunPerDir',   nTrialsRunPerDir, ...
                'stimValues',         stimVals(:), ...
                'stimVariant',        stimVariant, ...
                'sessionLabel',       sprintf('%s_%s', thisMouse, thisSessionName));
        end

        sessionLabels = [sessionLabels; repmat({sprintf('%s_%s', thisMouse, thisSessionName)}, nBoutons, 1)];
        fprintf('  Added %d boutons (running total: %d).\n', nBoutons, numel(allDirTuning));
    end
end

nBoutonsTotal = numel(allDirTuning);
fprintf('\nDone pooling. %d boutons total across %d mice (RUNNING trials only).\n', nBoutonsTotal, numel(uniqueMice));

%% report: how many trials per direction survive the running filter
if ~isempty(sessionRunCounts)
    fprintf('\n=== Running-trial counts per direction, across %d sessions ===\n', size(sessionRunCounts,1));
    fprintf('%-8s %8s %8s %8s\n', 'Dir#', 'Mean', 'Min', 'Max');
    for d = 1:size(sessionRunCounts, 2)
        fprintf('%-8d %8.1f %8d %8d\n', d, mean(sessionRunCounts(:,d)), min(sessionRunCounts(:,d)), max(sessionRunCounts(:,d)));
    end
    fprintf('\nMin running trials in ANY direction, ANY session: %d\n', min(sessionRunCounts(:)));
    fprintf('(This last number is the effective ceiling for nTrialsTarget-style downsampling below.)\n');
else
    fprintf('\nNo sessions produced valid running-trial counts to summarize.\n');
end

%% ANOVA-based responsiveness (running trials only)
nDirCheck = arrayfun(@(s) numel(s.trialMeanResp), allDirTuning);

anovaP           = nan(nBoutonsTotal, 1);
baseMean         = nan(nBoutonsTotal, 1);
baseSD           = nan(nBoutonsTotal, 1);
meanPreferredRaw = nan(nBoutonsTotal, 1);
prefDirIdx       = nan(nBoutonsTotal, 1);
isResponsive     = false(nBoutonsTotal, 1);

for b = 1:nBoutonsTotal
    s    = allDirTuning(b);
    nDir = numel(s.trialMeanResp);

    y = []; grp = [];
    for thisDir = 1:nDir
        vals = s.trialMeanResp{thisDir}(:);
        y    = [y;   vals];
        grp  = [grp; repmat(thisDir, numel(vals), 1)];
    end

    if numel(y) < nDir * 2 || all(isnan(y))
        continue;
    end

    validRows = ~isnan(y);
    anovaP(b) = anova1(y(validRows), grp(validRows), 'off');

    baselinePool = vertcat(s.trialBaselineVals{:});
    baselinePool = baselinePool(~isnan(baselinePool));
    baseMean(b)  = mean(baselinePool);
    baseSD(b)    = std(baselinePool);

    [~, prefDirIdx(b)] = max(s.meanDirResponse);
    meanPreferredRaw(b) = mean(s.trialRawResp{prefDirIdx(b)}, 'omitnan');

    isResponsive(b) = (anovaP(b) < alpha) && ...
                      (meanPreferredRaw(b) > baseMean(b) + numSD * baseSD(b));
end

fprintf('\n%d / %d boutons responsive (ANOVA[dirs]+threshold, p<%.2f, >%dSD above baseline, RUNNING only).\n', ...
    sum(isResponsive), nBoutonsTotal, alpha, numSD);

for b = 1:nBoutonsTotal
    allDirTuning(b).anovaP_run           = anovaP(b);
    allDirTuning(b).baseMean_run         = baseMean(b);
    allDirTuning(b).baseSD_run           = baseSD(b);
    allDirTuning(b).meanPreferredRaw_run = meanPreferredRaw(b);
    allDirTuning(b).prefDirIdx_run       = prefDirIdx(b);
    allDirTuning(b).isResponsive_run     = isResponsive(b);
end

%% ANOVA-protected t-test / Wilcoxon vs pooled baseline (running trials only)
ttestP   = nan(nBoutonsTotal, 1);
ranksumP = nan(nBoutonsTotal, 1);
isResponsive_ttest   = false(nBoutonsTotal, 1);
isResponsive_ranksum = false(nBoutonsTotal, 1);

for b = 1:nBoutonsTotal
    s = allDirTuning(b);
    if isnan(anovaP(b)) || isnan(prefDirIdx(b))
        continue;
    end

    prefTrials = s.trialRawResp{prefDirIdx(b)}(:);
    prefTrials = prefTrials(~isnan(prefTrials));

    baselineTrials = vertcat(s.trialBaselineVals{:});
    baselineTrials = baselineTrials(~isnan(baselineTrials));

    if numel(prefTrials) < 2 || numel(baselineTrials) < 2
        continue;
    end

    [~, ttestP(b)] = ttest2(prefTrials, baselineTrials, 'Vartype', 'unequal');
    ranksumP(b) = ranksum(prefTrials, baselineTrials);

    isResponsive_ttest(b)   = (anovaP(b) < alpha) && (ttestP(b) < alpha) && (meanPreferredRaw(b) > baseMean(b));
    isResponsive_ranksum(b) = (anovaP(b) < alpha) && (ranksumP(b) < alpha) && (meanPreferredRaw(b) > baseMean(b));
end

fprintf('%d / %d boutons responsive (ANOVA-protected Welch t-test, p<%.2f, RUNNING only).\n', sum(isResponsive_ttest), nBoutonsTotal, alpha);
fprintf('%d / %d boutons responsive (ANOVA-protected Wilcoxon, p<%.2f, RUNNING only).\n', sum(isResponsive_ranksum), nBoutonsTotal, alpha);

for b = 1:nBoutonsTotal
    allDirTuning(b).ttestP_run             = ttestP(b);
    allDirTuning(b).ranksumP_run           = ranksumP(b);
    allDirTuning(b).isResponsive_ttest_run   = isResponsive_ttest(b);
    allDirTuning(b).isResponsive_ranksum_run = isResponsive_ranksum(b);
end

%% ============================================================
%  Cross-validated R^2 (calc_kfold_R2), RUNNING TRIALS ONLY
%  -- main focus of this script --
% ============================================================
%
% Same pattern as the DotFields running-only script: for each bouton,
% pull the per-trial response-window value for each direction
% (trialRawResp, RAW scale -- swap to trialMeanResp for the
% baseline-subtracted version, see note in Figure5_3_DriftingGratings_basics.m),
% downsample every direction to the SAME number of trials (the minimum
% across directions for that bouton), then run k-fold cross-validated
% R^2 on the resulting [1 x nDir] cell array of equal-length trial
% vectors.
%
% Downsampling is necessary here for two independent reasons:
%   1) calc_kfold_R2 (like the DotFields version) expects equal trial
%      counts per condition to build folds.
%   2) The running filter itself removes a variable number of trials
%      per direction (an animal may run more during some directions
%      than others), so trial counts were already unequal before this
%      step even starts.
%
% nTrialsTarget below sets a GLOBAL minimum trial count floor across
% ALL boutons (mirrors the DotFields script's nTrialsTarget, which was
% referenced there but not defined in the uploaded file -- set it
% explicitly here). Any bouton whose minimum running-trial count (across
% its 8 directions) is below this floor is skipped entirely, rather than
% downsampled to a very small, noisy trial count. Boutons that pass are
% then downsampled per-bouton to their own minimum (>= nTrialsTarget).

nTrialsTarget = 5; % <-- ADJUST: minimum trials/direction required to attempt cvR2 for a bouton.
                    % Check the "Min running trials in ANY direction, ANY session"
                    % line printed above -- if that number is very low,
                    % consider lowering nTrialsTarget (fewer boutons pass,
                    % but at least some data survives) or accept that most
                    % boutons will be excluded from the running-only analysis.

cvR2   = nan(nBoutonsTotal, 1);
cvPval = nan(nBoutonsTotal, 1);
minTrialUsed = nan(nBoutonsTotal, 1); % how many trials/direction each bouton actually used, for reporting

for b = 1:nBoutonsTotal
    s    = allDirTuning(b);
    nDir = numel(s.trialMeanResp);

    gca = cell(1, nDir);
    for thisDir = 1:nDir
        vals = s.trialRawResp{thisDir}(:)';  % SWAP to s.trialMeanResp{thisDir}(:)' to match baseline-subtracted convention
        vals = vals(~isnan(vals));
        gca{thisDir} = vals;
    end

    trialCounts = cellfun(@numel, gca);
    if any(trialCounts == 0)
        continue; % a direction with zero running trials for this bouton -- skip
    end

    minTrial = min(trialCounts);
    if minTrial < nTrialsTarget
        continue; % not enough running trials in the sparsest direction -- skip rather than downsample too aggressively
    end

    gcaDownsampled = cellfun(@(x) x(1:minTrial), gca, 'UniformOutput', false);
    minTrialUsed(b) = minTrial;

    [cvR2(b), cvPval(b)] = calc_kfold_R2(gcaDownsampled, r2opts.kval, r2opts.nPerms, ...
        r2opts.randFlag, r2opts.validMeans, r2opts.nShuffle, seed);

    if mod(b, 100) == 0
        fprintf('Processed %d / %d boutons (cross-val R^2, running only)...\n', b, nBoutonsTotal);
    end
end

isTunedCVR2_run = cvR2 > r2_thresh & cvPval < alpha;
fprintf('\n%d / %d boutons show significant cross-validated tuning (p<%.2f, R^2>%.2f, RUNNING only).\n', ...
    sum(isTunedCVR2_run, 'omitnan'), nBoutonsTotal, alpha, r2_thresh);

nAttempted = sum(~isnan(cvR2));
fprintf('%d / %d boutons had >= %d running trials/direction and were attempted (rest skipped for insufficient running trials).\n', ...
    nAttempted, nBoutonsTotal, nTrialsTarget);
if nAttempted > 0
    fprintf('Trials/direction actually used after downsampling -- mean: %.1f, min: %d, max: %d\n', ...
        mean(minTrialUsed, 'omitnan'), min(minTrialUsed), max(minTrialUsed));
end

for b = 1:nBoutonsTotal
    allDirTuning(b).cvR2_run         = cvR2(b);
    allDirTuning(b).cvPval_run       = cvPval(b);
    allDirTuning(b).isTunedCVR2_run  = isTunedCVR2_run(b);
    allDirTuning(b).minTrialUsed_run = minTrialUsed(b);
end

validIdx_run = find(cat(1, allDirTuning.cvR2_run) > r2_thresh & cat(1, allDirTuning.cvPval_run) < r2p_thresh);
fprintf('\n%d / %d boutons pass R^2 filter (R^2>%.2f, p<%.2f), RUNNING only.\n', ...
    numel(validIdx_run), nBoutonsTotal, r2_thresh, r2p_thresh);

%% (optional) OSI/DSI on running-only data -- uncomment once satisfied with the above
allDirTuning = computeDirTuningOSI(allDirTuning, 'isTunedCVR2_run');
allDirTuning = computeDirTuningDSI(allDirTuning, 'isTunedCVR2_run');


figA = plotExampleDirTuningBouton(allDirTuning, 1453)
plotExampleDirTuningBouton(allDirTuning, 1076)
DirTuning_OSI_DSI_SummaryFigures_RunningOnly




