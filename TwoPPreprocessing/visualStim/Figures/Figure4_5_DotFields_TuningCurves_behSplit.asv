figU = figure('Color', 'w', 'Position', [200 200 350 420]);
hold on;
for i = 1:numel(prefSpeed_stat_both)
    % small jitter so overlapping integer values are visible as distinct lines
    jit = (rand-0.5)*0.15;
    plot([1 2]+jit, [prefSpeed_stat_both(i) prefSpeed_run_both(i)], '-', ...
        'Color', [0.75 0.75 0.75], 'LineWidth', 1);
    plot(1+jit, prefSpeed_stat_both(i), 'o', 'Color', 'k', 'MarkerFaceColor', 'k', 'MarkerSize', 6);
    plot(2+jit, prefSpeed_run_both(i),  'o', 'Color', 'r', 'MarkerFaceColor', 'r', 'MarkerSize', 6);
end

xlim([0.5 2.5]);
set(gca, 'XTick', [1 2], 'XTickLabel', {'Stationary', 'Locomotion'});
set(gca, 'YTick', 1:6, 'YTickLabel', arrayfun(@(v) sprintf('%g', v), speeds, 'UniformOutput', false));
ylabel('Preferred speed (\circ/s)');
title(sprintf('Preferred speed shift, dual-tuned boutons (n=%d)\nSign test p=%.3g | signrank p=%.3g', ...
    numel(validIdx_both), pSign, pSR), 'FontSize', 10);
box off; hold off;
