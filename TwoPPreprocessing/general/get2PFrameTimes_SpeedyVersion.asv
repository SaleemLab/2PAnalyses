function [sessionFileInfo] = get2PFrameTimes_SpeedyVersion(sessionFileInfo, nPlanes, isZcorrected)
% Calculates stimulus frame ranges from Suite2p output for multiple planes.
%
% This function uses a robust lookup method. It first creates a dictionary
% mapping every TIFF file processed by Suite2p to its exact frame count.
% It then uses 'sessionFileInfo.stimFiles' to sum the frames for each
% stimulus by looking up each file individually. This avoids brittle counters
% and reliance on file order.
%
% Arguments:
%   - sessionFileInfo: Struct with session info, including '.stimFiles'.
%   - nPlanes: The total number of imaging planes for the session.
%   - isZcorrected: Boolean (true/false) indicating if Z-motion correction
%                   was applied, collapsing planes.

% --- Argument and Path Setup ---
if nargin < 3
    error('isZcorrected flag (true or false) is required.');
end
rootDir = sessionFileInfo.Directories.rootDir;
save_folder = fullfile(rootDir, 'Analysis', sessionFileInfo.session_name);
save_fileName = [sessionFileInfo.animal_name '_' sessionFileInfo.session_name '_sessionFileInfo.mat'];
suite2pDir = fullfile(rootDir, 'Processed', sessionFileInfo.session_name, 'suite2p');
nStimuli = length(sessionFileInfo.stimFiles);
stimuli_names = {sessionFileInfo.stimFiles.name};
framerun = struct();

%% --- Calculate Frame Runs Based on Processing Pipeline ---

if isZcorrected
    % --- SCENARIO 1: Z-corrected (One 'plane' folder) ---
    disp('Z-corrected mode: Calculating frame runs once and replicating...');
    plane_folder_path = fullfile(suite2pDir, 'plane');
    if ~exist(plane_folder_path, 'dir')
        error('Z-corrected mode failed: Folder not found at %s', plane_folder_path);
    end
    
    % Build the lookup map and calculate ranges from the single 'plane' folder
    [stim_ranges, plane_names_out] = process_plane(plane_folder_path, 'plane', sessionFileInfo, nPlanes, true);
    
    % Replicate these ranges for every conceptual plane
    for iPlane = 1:nPlanes
        framerun.(plane_names_out{iPlane}) = stim_ranges;
    end

else
    % --- SCENARIO 2: Multi-plane (Multiple 'planeN' folders) ---
    disp('Multi-plane mode: Calculating frame runs for each plane individually...');
    planeItems = dir(fullfile(suite2pDir, 'plane*'));
    planeFolders = planeItems([planeItems.isdir]);
    if isempty(planeFolders)
        error('Multi-plane mode failed: No ''plane*'' folders found in %s', suite2pDir);
    end
    [~, sortIdx] = sort( cellfun(@(s) str2double(regexp(s, '\d+', 'match', 'once')), {planeFolders.name}) );
    planeFolders = planeFolders(sortIdx);

    if length(planeFolders) ~= nPlanes
        warning('Mismatch: Expected %d planes, but found %d folders. Using %d.', nPlanes, length(planeFolders), length(planeFolders));
        nPlanes = length(planeFolders);
    end

    % Loop and process each plane folder to get its unique frame counts
    for iPlane = 1:nPlanes
        plane_name = planeFolders(iPlane).name;
        fprintf('Processing %s...\n', plane_name);
        [stim_ranges, ~] = process_plane(fullfile(suite2pDir, plane_name), plane_name, sessionFileInfo, nPlanes, false);
        framerun.(plane_name) = stim_ranges;
    end
    plane_names_out = {planeFolders.name};
end

%% --- Restructure and Save ---
disp('Final Frame Counts by Plane for Each Stimulus:');
framerun_table_data = cell(nPlanes, nStimuli);
for kPlane = 1:nPlanes
    plane_name = plane_names_out{kPlane};
    for iStim = 1:nStimuli
        stim_name = stimuli_names{iStim};
        frame_range = framerun.(plane_name).(stim_name);
        framerun_table_data{kPlane, iStim} = {frame_range};
    end
end
stim_frameruns = cell2table(framerun_table_data, 'VariableNames', stimuli_names, 'RowNames', plane_names_out);
disp(stim_frameruns);

sessionFileInfo.stim_framerun = stim_frameruns;
sessionFileInfo.Directories.save_folder = save_folder;
if ~exist(save_folder, 'dir'), mkdir(save_folder); end
save(fullfile(save_folder, save_fileName), 'sessionFileInfo', '-append');
fprintf('\nSuccessfully updated and saved sessionFileInfo.\n');

end

% --- Main Helper Function to Process a Single Plane Folder ---
function [stim_ranges, plane_names] = process_plane(plane_path, plane_name, sessionFileInfo, nPlanes, isZcorrected)
    fallMatPath = fullfile(plane_path, 'fall.mat');
    if ~exist(fallMatPath, 'file'), error('fall.mat not found in %s', plane_path); end
    
    s2p_data = load(fallMatPath, 'ops');
    
    % --- THIS IS THE KEY LOGIC: Create a lookup map ---
    % It maps each TIFF file path to its specific frame count.
    % This is robust and does not depend on file order.
    try
        s2p_filelist = s2p_data.ops.filelist;
        s2p_framecounts = s2p_data.ops.frames_per_folder;
        frameCountMap = containers.Map(s2p_filelist, s2p_framecounts);
    catch ME
        error('Could not create frame count map. Check ''ops.filelist'' and ''ops.frames_per_folder'' in %s. Error: %s', fallMatPath, ME.message);
    end
    
    stim_ranges = struct();
    cumulative_frames = 0;
    
    % Iterate through stimuli defined in sessionFileInfo
    for iStim = 1:length(sessionFileInfo.stimFiles)
        stimName = sessionFileInfo.stimFiles(iStim).name;
        files_for_this_stim = sessionFileInfo.stimFiles(iStim).tif_filepaths;
        
        frames_in_stim = 0;
        % For each file belonging to this stimulus...
        for iFile = 1:length(files_for_this_stim)
            current_file = files_for_this_stim{iFile};
            % ...look up its frame count in our map.
            if isKey(frameCountMap, current_file)
                frames_in_stim = frames_in_stim + frameCountMap(current_file);
            else
                warning('File listed in sessionFileInfo was NOT found in Suite2p''s ops.filelist and will be ignored: %s', current_file);
            end
        end
        
        start_range = cumulative_frames + 1;
        end_range = cumulative_frames + frames_in_stim;
        stim_ranges.(stimName) = [start_range, end_range];
        
        cumulative_frames = end_range;
    end
    
    if isZcorrected
        plane_names = arrayfun(@(x) ['plane' num2str(x)], 0:nPlanes-1, 'UniformOutput', false);
    else
        plane_names = {plane_name};
    end
end